function filtrarMaiores(tabela, limite)
    local resultado = {}
    for i = 1, #tabela do
        if tabela[i] > limite then
            table.insert(resultado, tabela[i])
        end
    end
    return resultado
end

print("Digite a quantidade de elementos (N):")
local N = tonumber(io.read())

local numeros = {}
for i = 1, N do
    print("Digite o elemento " .. i .. ":")
    local val = tonumber(io.read())
    table.insert(numeros, val)
end

print("Digite o valor limite (K):")
local K = tonumber(io.read())

local filtrados = filtrarMaiores(numeros, K)

print("--- Elementos maiores que " .. K .. " ---")
for i = 1, #filtrados do
    print(filtrados[i])
end
function contarOcorrencias(tabela, alvo)
    local contador = 0
    for i = 1, #tabela do
        if tabela[i] == alvo then
            contador = contador + 1
        end
    end
    return contador
end

print("Digite a quantidade de elementos (N):")
local N = tonumber(io.read())

local numeros = {}
for i = 1, N do
    print("Digite o elemento " .. i .. ":")
    local val = tonumber(io.read())
    table.insert(numeros, val)
end

print("Digite o numero X a ser buscado:")
local X = tonumber(io.read())

local total = contarOcorrencias(numeros, X)
print("O numero " .. X .. " aparece " .. total .. " vez(es) na tabela.")